# Telegram (Wajib untuk Fase 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub (Diisi pada Fase 4 - PAT read-only atau OAuth Device Flow)
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOS=
GITHUB_CLIENT_ID=

# Gemini (Diisi pada Fase 5 - Google AI Studio API Key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Monev (Diisi pada Fase 6)
MONEV_URL=
BROWSER_PROFILE_DIR=./data/browser-profile
DRY_RUN=true

# Umum
TZ=Asia/Jakarta
SCHEDULE_TIME=16:00
APPROVAL_TIMEOUT_HOURS=3
LOG_LEVEL=info

# Supabase (Wajib untuk database - Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
