# Telegram (Wajib untuk Fase 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub (Diisi pada Fase 4 - PAT read-only atau OAuth Device Flow)
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOS=
GITHUB_CLIENT_ID=

# Gemini (Diisi pada Fase 5 - Google AI Studio API Key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Monev (Diisi pada Fase 6)
MONEV_URL=
BROWSER_PROFILE_DIR=./data/browser-profile
DRY_RUN=true

# Umum
TZ=Asia/Jakarta
SCHEDULE_TIME=14:00
APPROVAL_TIMEOUT_HOURS=3
LOG_LEVEL=info

# MySQL (Fase 2)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=monev_bot
