{
  "name": "monev-bot",
  "version": "0.1.0",
  "description": "Bot laporan harian Monev (GitHub -> Gemini -> Telegram -> Monev) dengan prinsip human-in-the-loop",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@octokit/rest": "^22.0.1",
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
